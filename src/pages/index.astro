---
import ArticleCard from "../components/ArticleCard.astro";
import ExperimentCard from "../components/ExperimentCard.astro";
import ObservationCard from "../components/ObservationCard.astro";
import { getCollection } from "astro:content";

const [articles, experiments, observations] = await Promise.all([
  getCollection("articles"),
  getCollection("experiments"),
  getCollection("notes"),
]);
const latestArticles = articles
  .sort((first, second) => second.data.date.getTime() - first.data.date.getTime());
const currentExperiments = experiments
  .sort((first, second) => second.data.started.getTime() - first.data.started.getTime());
const latestObservations = observations
  .sort((first, second) => second.data.date.getTime() - first.data.date.getTime());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Field notes, observations, and experiments on technology, AI, systems, data, and the people navigating them."
    />
    <meta name="theme-color" content="#0b0b0a" />
    <title>Field Notes — Ideas worth keeping</title>
  </head>
  <body>
    <main>
      <header class="site-header">
        <a class="publication-mark" href="#top" aria-label="Field Notes, home">
          <span class="mark-icon" aria-hidden="true">f.</span>
          <span>FIELD NOTES</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="#observations">Insights</a>
          <a href="/writing">Writing</a>
          <a href="/experiments">Experiments</a>
          <a href="/notes">Notes</a>
          <a href="/about">About</a>
          <label class="language-switcher">
            <span aria-hidden="true">LANG</span>
            <select aria-label="Filter content language">
              <option value="all">All</option>
              <option value="id">ID</option>
              <option value="en">EN</option>
            </select>
          </label>
        </nav>
      </header>

      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-rule"></span> FIELD NOTES</p>
          <h1 id="hero-title">Not Everything<br />Worth Knowing<br />Becomes A<br /><em>Headline.</em></h1>
          <p class="hero-intro">
            Notes, observations, experiments, and lessons from technology, AI,
            systems, data, and the people navigating them.
          </p>
          <a class="text-link" href="/writing">
            Read the latest note <span aria-hidden="true">↘</span>
          </a>
        </div>

        <aside class="observation-card filterable" data-language="en" aria-labelledby="latest-observation">
          <div class="note-topline">
            <span>THE NOTEBOOK</span>
            <span>NO. 018</span>
          </div>
          <div class="note-rule"></div>
          <p class="note-kicker" id="latest-observation">LATEST OBSERVATION</p>
          <blockquote>
            <p>AI is rapidly reducing<br />the cost of answers.</p>
            <p>It is simultaneously<br />increasing the value of<br /><em>good questions.</em></p>
          </blockquote>
          <div class="note-bottom">
            <span>ON QUESTIONS &amp; ANSWERS</span>
            <span class="note-mark" aria-hidden="true">✳</span>
          </div>
        </aside>
      </section>

      <section class="section writing" id="writing" aria-labelledby="writing-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Ideas, in a little more depth</p>
            <h2 id="writing-title">Latest writing</h2>
          </div>
          <a class="section-link" href="/writing">All writing <span aria-hidden="true">↗</span></a>
        </div>
        <div class="writing-list home-preview" data-content-list="articles" data-preview-limit="3">
          {latestArticles.map((article, index) => (
            <ArticleCard article={article} index={index + 1} />
          ))}
        </div>
      </section>

      <section class="section experiments" id="experiments" aria-labelledby="experiments-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Things currently being explored</p>
            <h2 id="experiments-title">Current experiments</h2>
          </div>
          <a class="section-link" href="/experiments">All experiments <span aria-hidden="true">↗</span></a>
        </div>
        <div class="experiment-grid home-preview" data-content-list="experiments" data-preview-limit="2">
          {currentExperiments.map((experiment, index) => (
            <ExperimentCard experiment={experiment} index={index + 1} />
          ))}
        </div>
      </section>

      <section class="section observations" id="observations" aria-labelledby="observations-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Short thoughts, left to grow</p>
            <h2 id="observations-title">Collected observations</h2>
          </div>
          <a class="section-link" href="/notes">All notes <span aria-hidden="true">↗</span></a>
        </div>
        <div class="observation-list home-preview" data-content-list="notes" data-preview-limit="3">
          {latestObservations.map((observation, index) => (
            <ObservationCard observation={observation} index={index + 1} />
          ))}
        </div>
      </section>

      <section class="site-note" id="about" aria-labelledby="site-note-title">
        <p class="eyebrow">A note on this place</p>
        <h2 id="site-note-title">A garden for ideas that deserve <em>a little more time.</em></h2>
        <div class="site-note-aside">
          <p>
            This website exists to collect observations, lessons, experiments,
            and ideas that might help someone think differently.
          </p>
          <span>KEEP WHAT'S USEFUL. LET THE REST GROW.</span>
        </div>
      </section>

      <footer class="site-footer">
        <p>Curated by Firman Syamsudin. <span>Stay curious.</span></p>
        <a href="#top">BACK TO THE BEGINNING ↑</a>
      </footer>
    </main>
    <script is:inline src="/language-filter.js"></script>
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap");

  :root {
    color-scheme: dark;
    --bg: #0b0b0a;
    --surface: #11110f;
    --text: #f3efe6;
    --muted: #a7a399;
    --quiet: #77746b;
    --gold: #b8a06a;
    --line: #292822;
    --serif: "Instrument Serif", "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    --sans: "DM Sans", "Helvetica Neue", sans-serif;
    --mono: "DM Mono", "SFMono-Regular", Consolas, monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 30px;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 15px;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main {
    width: min(1120px, calc(100% - 96px));
    margin-inline: auto;
  }

  .site-header {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }

  .publication-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: .14em;
  }

  .mark-icon {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 1px solid #494438;
    border-radius: 50%;
    color: var(--gold);
    font-family: var(--serif);
    font-size: 19px;
    font-style: italic;
    letter-spacing: -.05em;
  }

  .site-header nav {
    display: flex;
    gap: 31px;
    color: var(--muted);
    font-size: 11px;
  }

  .language-switcher {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: .1em;
  }

  .language-switcher select {
    border: 1px solid var(--line);
    padding: 4px 5px;
    background: var(--bg);
    color: var(--muted);
    font: inherit;
  }

  .site-header nav a,
  .text-link,
  .site-footer a {
    transition: color 180ms ease;
  }

  .site-header nav a:hover,
  .text-link:hover,
  .site-footer a:hover {
    color: var(--gold);
  }

  .hero {
    min-height: min(735px, calc(100svh - 76px));
    display: grid;
    grid-template-columns: 1.12fr .88fr;
    align-items: center;
    gap: 70px;
    padding: 82px 0 96px;
    border-bottom: 1px solid var(--line);
  }

  .eyebrow,
  .section-count,
  .note-topline,
  .note-kicker,
  .note-bottom,
  .site-note-aside > span,
  .site-footer a {
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .hero .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 27px;
    color: var(--gold);
  }

  .eyebrow-rule {
    width: 26px;
    height: 1px;
    background: var(--gold);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 23px;
    font-family: var(--serif);
    font-size: clamp(61px, 7.1vw, 91px);
    font-weight: 400;
    letter-spacing: -.045em;
    line-height: .89;
  }

  h1 em,
  .site-note h2 em {
    color: var(--gold);
    font-weight: 400;
  }

  .hero-intro {
    max-width: 430px;
    margin-bottom: 25px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.85;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    color: var(--gold);
    font-size: 11px;
  }

  .text-link span {
    font-size: 14px;
  }

  .observation-card {
    position: relative;
    min-height: 420px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 23px 28px 20px;
    overflow: hidden;
    border: 1px solid #302e27;
    background:
      linear-gradient(90deg, transparent 0, transparent 34px, rgb(184 160 106 / 12%) 35px, transparent 36px),
      repeating-linear-gradient(to bottom, transparent 0, transparent 43px, rgb(243 239 230 / 3.5%) 44px, transparent 45px),
      #10100e;
  }

  .note-topline {
    display: flex;
    justify-content: space-between;
    color: var(--quiet);
    font-size: 8px;
  }

  .note-rule {
    position: absolute;
    top: 62px;
    right: 28px;
    left: 28px;
    height: 1px;
    background: var(--line);
  }

  .note-kicker {
    margin: 46px 0 14px 15px;
    color: var(--gold);
    font-size: 8px;
  }

  .observation-card blockquote {
    margin: 0 0 20px 15px;
    font-family: var(--serif);
    font-size: clamp(27px, 3.1vw, 39px);
    letter-spacing: -.015em;
    line-height: 1.14;
  }

  .observation-card blockquote p {
    margin: 0 0 15px;
  }

  .observation-card blockquote em {
    color: var(--gold);
    font-weight: 400;
  }

  .note-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-left: 15px;
    color: var(--quiet);
    font-size: 8px;
  }

  .note-mark {
    color: var(--gold);
    font-family: var(--sans);
    font-size: 16px;
  }

  .section {
    padding: 88px 0 94px;
    border-bottom: 1px solid var(--line);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .section-heading .eyebrow {
    margin-bottom: 12px;
    color: var(--quiet);
    font-size: 8px;
  }

  .section-heading h2 {
    margin-bottom: 0;
    font-family: var(--serif);
    font-size: 47px;
    font-weight: 400;
    letter-spacing: -.025em;
    line-height: 1;
  }

  .section-count {
    padding-bottom: 5px;
    color: var(--quiet);
    font-size: 8px;
    white-space: nowrap;
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding-bottom: 5px;
    color: var(--gold);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: .1em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .section-link:hover {
    color: var(--text);
  }

  .writing-list {
    border-top: 1px solid var(--line);
  }

  .experiment-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .observation-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .observation-list .observation-card + .observation-card {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .site-note {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 50px;
    padding: 82px 0 88px;
    border-bottom: 1px solid var(--line);
  }

  .site-note > .eyebrow {
    grid-column: 1 / -1;
    margin-bottom: -34px;
    color: var(--quiet);
    font-size: 8px;
  }

  .site-note h2 {
    max-width: 540px;
    margin-bottom: 0;
    font-family: var(--serif);
    font-size: clamp(39px, 5vw, 59px);
    font-weight: 400;
    letter-spacing: -.025em;
    line-height: .98;
  }

  .site-note-aside {
    padding: 0 0 5px 25px;
    border-left: 1px solid var(--line);
  }

  .site-note-aside p {
    max-width: 390px;
    margin-bottom: 19px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.85;
  }

  .site-note-aside > span {
    color: var(--gold);
    font-size: 7px;
  }

  .site-footer {
    min-height: 75px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .site-footer p {
    margin-bottom: 0;
    color: var(--quiet);
    font-size: 10px;
  }

  .site-footer p span {
    color: var(--muted);
  }

  .site-footer a {
    color: var(--quiet);
    font-size: 7px;
  }

  a:focus-visible {
    outline: 1px solid var(--gold);
    outline-offset: 5px;
  }

  @media (max-width: 820px) {
    main {
      width: min(100% - 56px, 680px);
    }

    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 46px;
      padding: 74px 0 60px;
    }

    .hero-copy {
      max-width: 560px;
    }

    h1 {
      font-size: clamp(66px, 11vw, 86px);
    }

    .observation-card {
      min-height: 370px;
    }

    .observation-card blockquote {
      font-size: clamp(32px, 6vw, 42px);
    }

    .section {
      padding: 68px 0 74px;
    }

    .site-note {
      gap: 30px;
    }

    .observation-list .observation-card {
      padding-right: 16px;
    }

    .observation-list .observation-card + .observation-card {
      padding-left: 16px;
    }
  }

  @media (max-width: 560px) {
    main {
      width: calc(100% - 38px);
    }

    .site-header {
      height: auto;
      min-height: 67px;
      flex-wrap: wrap;
      gap: 10px 12px;
      padding: 10px 0;
    }

    .site-header nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 8px;
      font-size: 8px;
    }

    .language-switcher {
      gap: 4px;
      font-size: 7px;
    }

    .language-switcher select {
      padding: 2px 3px;
      font-size: 8px;
    }

    .publication-mark {
      gap: 7px;
      font-size: 8px;
    }

    .mark-icon {
      width: 27px;
      height: 27px;
    }

    .hero {
      gap: 38px;
      padding: 59px 0 49px;
    }

    .hero .eyebrow {
      margin-bottom: 23px;
      font-size: 8px;
    }

    h1 {
      font-size: clamp(53px, 12.5vw, 70px);
      line-height: .91;
    }

    .hero-intro {
      max-width: 370px;
      font-size: 12px;
    }

    .observation-card {
      min-height: 340px;
      padding: 20px 18px 17px;
    }

    .note-rule {
      right: 18px;
      left: 18px;
    }

    .observation-card blockquote {
      margin-left: 10px;
      font-size: clamp(29px, 8vw, 37px);
    }

    .note-kicker,
    .note-bottom {
      margin-left: 10px;
    }

    .section {
      padding: 58px 0 62px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 13px;
      margin-bottom: 24px;
    }

    .section-heading h2 {
      font-size: 40px;
    }

    .section-count {
      padding: 0;
    }

    .experiment-grid {
      grid-template-columns: 1fr;
    }

    .observation-list {
      grid-template-columns: 1fr;
    }

    .observation-list .observation-card,
    .observation-list .observation-card + .observation-card {
      min-height: auto;
      padding: 23px 0;
      border-left: 0;
    }

    .site-note {
      grid-template-columns: 1fr;
      gap: 25px;
      padding: 59px 0 62px;
    }

    .site-note > .eyebrow {
      grid-column: auto;
      margin: 0 0 -12px;
    }

    .site-note h2 {
      font-size: 46px;
    }

    .site-note-aside {
      padding-left: 17px;
    }

    .site-footer {
      min-height: 80px;
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 8px;
      padding: 18px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      transition-duration: .01ms !important;
    }
  }
</style>
