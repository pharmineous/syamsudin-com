---
import type { CollectionEntry } from "astro:content";

interface Props {
  article: CollectionEntry<"articles">;
  index: number;
}

const { article, index } = Astro.props;
const href = article.data.url ?? `/writing#${article.id}`;
const formattedDate = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
  timeZone: "UTC",
}).format(article.data.date);
---

<a
  class={`writing-entry article-entry filterable${article.data.image ? " has-thumbnail" : ""}`}
  id={article.id}
  href={href}
  data-language={article.data.language}
  data-translated-summary={article.data.translatedSummary}
>
  <span class="entry-number">{String(index).padStart(2, "0")}</span>
  {article.data.image && (
    <img
      class="entry-thumbnail"
      src={article.data.image}
      alt={article.data.imageAlt ?? ""}
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="entry-copy">
    <p class="entry-topic">
      {article.data.category}<span aria-hidden="true">·</span>
      <span class="entry-language" aria-label={`Primary language: ${article.data.language.toUpperCase()}`}>
        {article.data.language.toUpperCase()}
      </span><span aria-hidden="true">·</span>
      <time datetime={article.data.date.toISOString().slice(0, 10)}>{formattedDate}</time>
    </p>
    <h3>{article.data.title}</h3>
    <p class="entry-summary">{article.data.summary}</p>
  </div>
  <span class="entry-arrow" aria-hidden="true">↗</span>
</a>

<style>
  .writing-entry {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 24px;
    align-items: start;
    gap: 19px;
    padding: 25px 0 27px;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .writing-entry.has-thumbnail {
    grid-template-columns: 48px minmax(110px, 160px) minmax(0, 1fr) 24px;
  }

  .entry-thumbnail {
    display: block;
    width: 100%;
    height: 96px;
    object-fit: cover;
    background: var(--surface);
  }

  .entry-number,
  .entry-topic {
    font-family: var(--mono);
    font-size: 8px;
    font-weight: 400;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .entry-number {
    padding-top: 4px;
    color: var(--quiet);
  }

  .entry-topic {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    color: var(--gold);
  }

  .entry-topic span {
    color: var(--quiet);
  }

  .entry-topic .entry-language {
    color: var(--gold);
  }

  .entry-topic time {
    color: var(--quiet);
  }

  .entry-copy h3 {
    margin: 0 0 8px;
    font-family: var(--serif);
    font-size: clamp(25px, 3vw, 34px);
    font-weight: 400;
    letter-spacing: -.015em;
    line-height: 1.08;
    transition: color 180ms ease;
  }

  .entry-summary {
    max-width: 650px;
    margin: 0;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 11px;
    line-height: 1.7;
  }

  .entry-arrow {
    padding-top: 2px;
    color: var(--quiet);
    font-size: 14px;
    transition: color 180ms ease, transform 180ms ease;
  }

  .writing-entry:hover .entry-copy h3 {
    color: var(--gold);
  }

  .writing-entry:hover .entry-arrow {
    transform: translate(2px, -2px);
    color: var(--gold);
  }

  .writing-entry:focus-visible {
    outline: 1px solid var(--gold);
    outline-offset: 5px;
  }

  @media (max-width: 560px) {
    .writing-entry {
      grid-template-columns: 28px minmax(0, 1fr) 15px;
      gap: 10px;
      padding: 22px 0;
    }

    .writing-entry.has-thumbnail {
      grid-template-columns: 28px 68px minmax(0, 1fr) 15px;
    }

    .entry-thumbnail {
      height: 64px;
    }

    .entry-copy h3 {
      font-size: 27px;
    }

    .entry-summary {
      font-size: 10px;
    }

    .entry-topic {
      font-size: 7px;
      letter-spacing: .09em;
    }
  }
</style>
